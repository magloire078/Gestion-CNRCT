rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
  
    // --- BASIC HELPERS ---
    
    function isSignedIn() {
      return request.auth != null;
    }

    function hasUserDoc() {
      return isSignedIn() && exists(/databases/$(database)/documents/users/$(request.auth.uid));
    }

    function getUserData() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }

    function hasRoleDoc(roleId) {
      return roleId != null && exists(/databases/$(database)/documents/roles/$(roleId));
    }

    function getRoleData(roleId) {
      return get(/databases/$(database)/documents/roles/$(roleId)).data;
    }

    // --- ROLE CHECKS (Zero/One Read optimized) ---
    
    // Le drapeau vit sur le document de rôle, que seul un super-admin peut
    // écrire : un utilisateur ne peut donc pas se l'octroyer. Le lire ici
    // plutôt que de lister des identifiants en dur rend la règle valable pour
    // n'importe quelle institution, sans identifiant propre à la CNRCT.
    function hasSuperAdminRole() {
      return hasUserDoc() &&
        hasRoleDoc(getUserData().get('roleId', null)) &&
        getRoleData(getUserData().get('roleId', null)).get('isSuperAdmin', false) == true;
    }

    // Les deux listes en dur sont conservées le temps que le drapeau
    // isSuperAdmin soit posé sur les rôles concernés (npm run db:flag-super-admins).
    // Les retirer avant cette migration verrouillerait les administrateurs
    // hors de l'application.
    function isSuperAdmin() {
      return isSignedIn() && (
        request.auth.token.get('email', '') in ['magloire078@gmail.com', 'admin@cnrct.ci'] ||
        (hasUserDoc() && getUserData().get('roleId', '') in ['super-admin', 'LHcHyfBzile3r0vyFOFb', 'dirigeant-president', 'administrateur', 'admin']) ||
        hasSuperAdminRole()
      );
    }
    
    // --- PERMISSION MATRIX HELPER (Synchronized with RESOURCES_CONFIG) ---
    
    function can(resource, action) {
      return isSignedIn() && (
        isSuperAdmin() ||
        (hasUserDoc() && checkResource(getUserData(), resource, action))
      );
    }

    function checkResource(user, res, act) {
      return user.get(['resourcePermissions', res, act], null) == true || 
        (user.get(['resourcePermissions', res, act], null) == null && 
         user.get('roleId', null) != null && 
         hasRoleDoc(user.get('roleId', null)) &&
         getRoleData(user.get('roleId', null)).get(['resourcePermissions', res, act], null) == true);
    }

    // --- TEMPORARY DEBUG ACCESS ---
    // match /{document=**} {
    //   allow read: if true;
    //   allow write: if isSignedIn();
    // }

    // --- SYSTEM & ADMIN ---
    
    match /roles/{roleId} {
      allow read: if isSignedIn();
      allow create, update, delete: if isSuperAdmin();
    }
    
    match /users/{userId} {
      allow get: if isSignedIn() && (request.auth.uid == userId || can('admin', 'read'));
      allow list: if can('admin', 'read');
      // isSuperAdmin() et can() tirent leurs droits de roleId et
      // resourcePermissions. L'update interdit déjà d'y toucher ; la création
      // doit l'interdire aussi, sinon un compte fraîchement inscrit se crée
      // son propre profil super-admin. L'inscription n'écrit que le rôle par
      // défaut : toute élévation passe par un super-admin.
      allow create: if isSuperAdmin() || (
        isSignedIn() && request.auth.uid == userId &&
        !request.resource.data.keys().hasAny(['resourcePermissions']) &&
        request.resource.data.get('roleId', '') == 'employe-operationnel'
      );
      allow update: if isSuperAdmin() || (
        request.auth.uid == userId && 
        !request.resource.data.diff(resource.data).affectedKeys().hasAny(['roleId', 'resourcePermissions'])
      );
      allow delete: if isSuperAdmin();
    }

    match /settings/{settingId} {
      allow read: if isSignedIn();
      allow update: if can('settings', 'update');
    }

    match /audit_logs/{id} {
      allow read: if can('audit-log', 'read');
      allow create: if isSignedIn();
    }

    match /print_logs/{id} {
      allow read, create: if isSignedIn();
      allow update, delete: if isSuperAdmin();
    }

    // --- EMPLOYEES & HR ---
    
    match /employees/{employeeId} {
      // Le bureau du Directoire affiché publiquement passe désormais par
      // /api/institution/directoire, qui ne renvoie que nom, poste et photo.
      // L'accès anonyme reste strictement fermé. Les utilisateurs authentifiés
      // accèdent aux fiches actives du Directoire pour le fonctionnement interne.
      allow read: if can('employees', 'read') ||
                   (isSignedIn() && (
                     employeeId == getUserData().get('employeeId', '') ||
                     resource.data.get('userId', '') == request.auth.uid ||
                     (resource.data.status == 'Actif' && (
                       resource.data.departmentId == '9ywKFDgVMS86rZLPYhpm' || 
                       resource.data.poste in ['Président', 'Secrétaire Général', 'Membre du Directoire']
                     ))
                   ));
      allow create: if can('employees', 'create');
      allow update: if can('employees', 'update');
      allow delete: if can('employees', 'delete');
      
      match /history/{eventId} {
        allow read: if can('employees', 'read') || (isSignedIn() && employeeId == getUserData().get('employeeId', ''));
        allow create, update, delete: if can('employees', 'update');
      }
    }

    match /payroll/{payrollId} {
      allow read: if can('payroll', 'read') || (isSignedIn() && resource.data.employeeId == getUserData().get('employeeId', ''));
      allow create: if can('payroll', 'create');
      allow update: if can('payroll', 'update');
      allow delete: if can('payroll', 'delete');
    }

    match /leaves/{leaveId} {
      allow read: if can('leaves', 'read') || (isSignedIn() && resource.data.employeeId == getUserData().get('employeeId', ''));
      allow create: if can('leaves', 'create') || (isSignedIn() && request.resource.data.employeeId == getUserData().get('employeeId', ''));
      allow update: if can('leaves', 'update');
      allow delete: if can('leaves', 'delete');
    }

    match /evaluations/{id} {
      allow read: if can('evaluations', 'read');
      allow create: if can('evaluations', 'create');
      allow update: if can('evaluations', 'update');
      allow delete: if can('evaluations', 'delete');
    }

    match /indemnities_calculations/{id} {
      allow read: if can('indemnities', 'read');
      allow create: if can('indemnities', 'create');
      allow delete: if can('indemnities', 'delete');
    }

    // --- LOCALITIES & TRADITIONS ---
    
    match /villages/{villageId} {
      function isValidVillage() {
        let data = request.resource.data;
        return data.keys().hasAll(['name', 'department', 'region']) &&
               data.name is string && data.name.size() > 0 &&
               data.department is string && data.region is string;
      }
      
      allow read: if can('villages', 'read');
      allow create: if can('villages', 'create') && isValidVillage();
      allow update: if can('villages', 'update') && isValidVillage();
      allow delete: if can('villages', 'delete') && isSuperAdmin(); // Restrict deletion to super admin
    }

    match /chiefs/{chiefId} {
      function isValidChief() {
        let data = request.resource.data;
        return data.keys().hasAll(['name', 'village']) &&
               data.name is string && data.name.size() > 0;
      }

      allow read: if can('chiefs', 'read');
      allow create: if can('chiefs', 'create') && isValidChief();
      allow update: if can('chiefs', 'update') && isValidChief() && 
                    (!request.resource.data.diff(resource.data).affectedKeys().hasAny(['career']) || can('chiefs-career', 'update')) &&
                    (!request.resource.data.diff(resource.data).affectedKeys().hasAny(['audit', 'meritPoints']) || can('chiefs-audit', 'update'));
      allow delete: if can('chiefs', 'delete') && isSuperAdmin(); // Restrict deletion to super admin
    }

    match /customs/{id} {
      allow read: if can('us-et-coutumes', 'read');
      allow create: if can('us-et-coutumes', 'create');
      allow update: if can('us-et-coutumes', 'update');
      allow delete: if can('us-et-coutumes', 'delete');
    }

    match /heritage/{assetId} {
      allow read: if can('heritage', 'read');
      allow create: if can('heritage', 'create');
      allow update: if can('heritage', 'update');
      allow delete: if can('heritage', 'delete');
    }

    // --- OPERATIONS & LOGISTICS ---
    
    match /missions/{missionId} {
      allow read: if can('missions', 'read') || 
                   (isSignedIn() && getUserData().get('employeeId', '') in resource.data.get('participantIds', []));
      allow create: if can('missions', 'create');
      allow update: if can('missions', 'update');
      allow delete: if can('missions', 'delete');
    }

    match /conflicts/{conflictId} {
      allow read: if can('conflicts', 'read');
      allow create: if can('conflicts', 'create');
      allow update: if can('conflicts', 'update');
      allow delete: if can('conflicts', 'delete');
    }

    match /assets/{assetId} {
      allow read: if can('it-assets', 'read');
      allow create: if can('it-assets', 'create');
      allow update: if can('it-assets', 'update');
      allow delete: if can('it-assets', 'delete');
    }

    match /fleet/{vehicleId} {
      allow read: if can('fleet', 'read');
      allow create: if can('fleet', 'create');
      allow update: if can('fleet', 'update');
      allow delete: if can('fleet', 'delete');
    }

    match /fuelCards/{id} {
      allow read: if can('fuel', 'read');
      allow create, update, delete: if can('fuel', 'update');
    }

    match /fuel_transactions/{id} {
      allow read: if can('fuel', 'read');
      allow create: if can('fuel', 'create');
      allow delete: if can('fuel', 'delete');
    }

    match /counters/{id} {
      allow read, write: if isSignedIn();
    }

    match /supplies/{supplyId} {
      allow read: if can('supplies', 'read');
      allow create: if can('supplies', 'create');
      allow update: if can('supplies', 'update');
      allow delete: if can('supplies', 'delete');
    }

    match /supply_transactions/{id} {
      allow read: if can('supplies', 'read');
      allow create: if can('supplies', 'create');
    }

    match /budgetLines/{lineId} {
      allow read: if can('budget', 'read');
      allow create, update, delete: if can('budget', 'update');
    }

    match /repository/{id} { 
      allow read: if can('repository', 'read'); 
      allow create: if can('repository', 'create'); 
      allow update: if can('repository', 'update'); 
      allow delete: if can('repository', 'delete'); 
    }

    match /documents/{id} {
      allow read: if can('documents', 'read') || can('repository', 'read');
      allow create: if can('documents', 'create') || can('repository', 'create');
      allow update: if can('documents', 'update') || can('repository', 'update');
      allow delete: if can('documents', 'delete') || can('repository', 'delete');
    }

    match /mails/{id} {
      allow read: if can('mails', 'read');
      allow create: if can('mails', 'create');
      allow update: if can('mails', 'update');
      allow delete: if can('mails', 'delete');
    }

    match /providers/{id} {
      allow read: if can('procurement', 'read');
      allow create: if can('procurement', 'create');
      allow update: if can('procurement', 'update');
      allow delete: if can('procurement', 'delete');
    }

    match /contracts/{id} {
      allow read: if can('procurement', 'read');
      allow create: if can('procurement', 'create');
      allow update: if can('procurement', 'update');
      allow delete: if can('procurement', 'delete');
    }

    match /press_articles/{id} {
      allow read: if can('conflicts', 'read');
      allow create: if can('conflicts', 'create');
      allow update: if can('conflicts', 'update');
      allow delete: if can('conflicts', 'delete');
    }

    match /kingdoms/{id} {
      allow read: if can('chiefs', 'read');
      allow create, update, delete: if can('chiefs', 'update') || isSuperAdmin();
    }

    match /cantons/{id} {
      allow read: if can('villages', 'read');
      allow create, update, delete: if can('villages', 'update') || isSuperAdmin();
    }

    match /tribus/{id} {
      allow read: if can('villages', 'read');
      allow create, update, delete: if can('villages', 'update') || isSuperAdmin();
    }

    match /complaints/{id} {
      allow read: if can('mgp', 'read') || resource.data.get('trackingId', '') != '';
      allow create: if true; // Soumission publique de plainte
      allow update: if can('mgp', 'update');
      allow delete: if can('mgp', 'delete');
    }

    // --- SYSTEM & METADATA ---
    
    match /notifications/{id} { 
      allow read: if isSignedIn() && (resource.data.userId == request.auth.uid || resource.data.userId == 'all');
      allow create: if isSuperAdmin(); // Seul le système/admin devrait créer des notifs
      allow update: if isSignedIn() && resource.data.userId == request.auth.uid && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['read']); // L'utilisateur ne peut que marquer comme lue
      allow delete: if isSignedIn() && resource.data.userId == request.auth.uid; // L'utilisateur ne peut supprimer que ses propres notifs
    }

    match /tickets/{id} { 
      allow read: if isSignedIn() && (resource.data.createdBy == request.auth.uid || can('tickets', 'read'));
      allow create: if isSignedIn();
      allow update: if resource.data.createdBy == request.auth.uid || can('tickets', 'update');
      allow delete: if isSuperAdmin();
    }

    match /news/{newsId} {
      allow read: if isSignedIn(); 
      allow create, update, delete: if can('news', 'update');
    }

    match /audit_logs/{id} {
      allow read: if isSuperAdmin() || can('admin', 'read');
      allow create: if isSignedIn();
      allow update, delete: if false;
    }

    match /departments/{id} { allow read: if isSignedIn(); allow write: if can('settings', 'update'); }
    match /directions/{id} { allow read: if isSignedIn(); allow write: if can('settings', 'update'); }
    match /services/{id} { allow read: if isSignedIn(); allow write: if can('settings', 'update'); }
    match /conflict-types/{id} { allow read: if isSignedIn(); allow write: if can('settings', 'update'); }
    match /fuel_providers/{id} { allow read: if isSignedIn(); allow write: if can('settings', 'update'); }
    match /supply_categories/{id} { 
      allow read: if true; 
      allow write: if can('supplies', 'update'); 
    }
  }
}
